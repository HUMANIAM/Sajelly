{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "models",
    "profiles",
    "lead_profile",
    "defaults",
    "risk_profiles",
    "max_parallel_helpers",
    "subjects"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1.0"
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lightweight",
        "standard",
        "deep",
        "critical"
      ],
      "properties": {
        "lightweight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "model_reasoning_effort"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_reasoning_effort": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "model_reasoning_effort"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_reasoning_effort": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "deep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "model_reasoning_effort"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_reasoning_effort": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "critical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "model_reasoning_effort"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_reasoning_effort": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "lead_profile": {
      "type": "string",
      "enum": [
        "lightweight",
        "standard",
        "deep",
        "critical"
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_risk",
        "system_criticality"
      ],
      "properties": {
        "change_risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "system_criticality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "risk_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "properties": {
        "low": {
          "type": "string",
          "enum": [
            "lightweight",
            "standard",
            "deep",
            "critical"
          ]
        },
        "medium": {
          "type": "string",
          "enum": [
            "lightweight",
            "standard",
            "deep",
            "critical"
          ]
        },
        "high": {
          "type": "string",
          "enum": [
            "lightweight",
            "standard",
            "deep",
            "critical"
          ]
        },
        "critical": {
          "type": "string",
          "enum": [
            "lightweight",
            "standard",
            "deep",
            "critical"
          ]
        }
      }
    },
    "max_parallel_helpers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "profile",
          "enabled",
          "focus"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "enum": [
              "lightweight",
              "standard",
              "deep",
              "critical"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "focus": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review execution settings",
  "description": "Editable settings for review subject routing and generated Codex reviewer defaults. Python validates references and safety floors in addition to this structural schema. Model catalog describes configured options, not proof of runtime access."
}
